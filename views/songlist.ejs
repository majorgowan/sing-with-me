<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
</head>

<body>

<%- include("partials/header.ejs") %>

<!-- TODO: implement search bar!! -->
<div id="search-bar-div">
    <input type="text" id="search-bar-input" placeholder="Search...">
</div>

<div id="create-new-song-div">
    <form action="/song" method="get">
        <button class="swm-button">Create new song!</button>
    </form>
</div>

<div id="song-list-div">
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Created by</th>
                <th>Modified</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% for (song of songList) { %>
                <tr>
                    <td>
                        <a href="/song?songId=<%= song.songId %>"><%= song.title %></a>
                    </td>
                    <td>
                        <%= song.createdBy %>
                    </td>
                    <td>
                        <%= song.modified ? new Date(song.modified).toLocaleString('en-CA', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric'
                        }) : ""
                        %>
                    </td>
                    <td>
                        <a href="/fork?songId=<%= song.songId %>">fork</a>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

</div>


</body>

</html>
